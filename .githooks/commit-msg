#!/bin/sh
# .githooks/commit-msg — versioned, installed via `git config core.hooksPath .githooks`.
# COMPLIANCE-AUDIT-2026-08-01.md fixes #3+#4 (H7 x2 / DoD-12 exit code / L29 tree-shipped / H14 UX
# report). This has to be a commit-msg hook, not pre-commit: the message text this checker reads does
# not exist as a file until the user has finished writing it, which is exactly the commit-msg stage.
# check-release.mjs is a no-op (exit 0 immediately) for any commit whose subject is not "release(vNNN)".
#
# ESCAPE HATCH (gate-scoping-report.md, 2026-08-01 follow-up): narrowed from a blanket META_SKIP_HOOK=1
# to a named META_SKIP_GATE, matching .githooks/pre-commit. This checker only has the one gate id
# ("check-release"), but the name still has to be typed (or "ALL") — never a bare flag — and every use
# is logged before the commit proceeds.
GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0

case ",${META_SKIP_GATE:-}," in
    *,check-release,*|*,ALL,*)
        ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
        branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
        mkdir -p .superpowers
        printf '{"ts":"%s","hook":"commit-msg","gates":"%s","branch":"%s"}\n' "$ts" "$META_SKIP_GATE" "$branch" >> .superpowers/gate-skip-log.jsonl
        echo "[commit-msg] META_SKIP_GATE=$META_SKIP_GATE — skipping check-release.mjs for this commit (recorded in .superpowers/gate-skip-log.jsonl)."
        exit 0
        ;;
esac

node scripts/check-release.mjs "$1"
status=$?
if [ $status -ne 0 ]; then
    echo ""
    echo "[commit-msg] BLOCKED: this release(v commit does not satisfy H7 x2 / DoD-12 / L29 / H14 (see above)."
    echo "[commit-msg] Escape hatch (named, logged — never silent): META_SKIP_GATE=check-release git commit ...   (or META_SKIP_GATE=ALL)"
    exit 1
fi
exit 0
