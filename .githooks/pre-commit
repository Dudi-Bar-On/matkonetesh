#!/bin/sh
# .githooks/pre-commit — versioned, installed via `git config core.hooksPath .githooks`.
# COMPLIANCE-AUDIT-2026-08-01.md fix #1: check-meta.mjs existed but was wired to NO git hook all day
# (2026-08-01) — .git/hooks held only the old graph tool's post-checkout/post-commit, both AFTER the fact, and
# the sole call site was scripts/sync-docs.sh:61, which no commit that day went through.
# This is now the "mechanical enforcement" the discipline doc has been claiming since §10.12.
#
# LAYERING (four legs, on purpose - see .claude/settings.json and .github/workflows/*.yml):
#   1. THIS hook = fast local structural feedback. Bypassable BY DESIGN (META_SKIP_GATE=<id>, see
#      below) — a local hook can never be the actual authority, because any developer can skip it,
#      same as today's `.git/hooks` was already technically present but unwired. Its job is to catch
#      problems before they cost a round-trip to CI, not to be trusted.
#   2. The `discipline` job in CI = the actual authority. It runs on every push/PR and cannot be
#      bypassed the way a local hook can.
#   3. The nightly `graph-freshness` schedule = covers what no commit hook OR push job can express:
#      a rule that goes stale from pure elapsed time and inaction, not from any one commit.
#   4. `.claude/settings.json`'s SessionStart hook (matcher: startup|resume|compact) = surfaces
#      existing red state at the moment work BEGINS (or resumes after compaction wipes context),
#      and blocks nothing — unlike the first three legs, its job is visibility, not enforcement.
#      Compaction gets it too, deliberately: compaction is precisely the moment the working memory
#      discipline depends on gets erased, and a rule re-anchored right after that event is worth
#      more than the same rule stated once at session start and then forgotten mid-session.
# A background daemon/watcher was considered and explicitly rejected for all of this: a daemon can
# die silently, which is exactly how 2026-08-01 happened. "Not running" must itself be an alarm —
# CI (and Claude Code's own hook lifecycle) gives that for free, a daemon does not.
#
# GATE SCOPING (gate-scoping-report.md, 2026-08-01 follow-up): a commit that PAID DOWN compliance
# debt was blocked by check-meta.mjs's OWN pre-existing red state (a stale graph, 22 historical
# briefs) — neither introduced nor worsened by that commit — forcing META_SKIP_HOOK=1. That is a gate
# working against its own purpose: routine bypass is exactly as protective as no gate. check-meta.mjs
# itself now judges the CHANGE, not the standing state, per-checker (see its own header for the full
# per-checker ruling); this hook's only remaining job is to stay fast and to make the escape hatch
# narrow and loud when it IS genuinely needed.
#
# Skip during rebase/merge/cherry-pick, the convention this directory has always used.
GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0

# Loud, explicit, NAMED override only — never silent, never a blanket default. META_SKIP_GATE names
# exactly which gate id(s) to skip, comma-separated (ids match check-meta.mjs's run() calls, e.g.
# "check-graph-fresh,check-brief"), or the literal "ALL" to skip everything — still has to be typed
# out, never implied. Every use is appended to .superpowers/gate-skip-log.jsonl BEFORE the commit
# proceeds, and check-meta.mjs prints that log's recent entries on every subsequent run (including
# SessionStart), so a skip cannot quietly age out of view.
if [ -n "${META_SKIP_GATE:-}" ]; then
    ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    mkdir -p .superpowers
    printf '{"ts":"%s","hook":"pre-commit","gates":"%s","branch":"%s"}\n' "$ts" "$META_SKIP_GATE" "$branch" >> .superpowers/gate-skip-log.jsonl
    echo "[pre-commit] META_SKIP_GATE=$META_SKIP_GATE — recorded in .superpowers/gate-skip-log.jsonl. Only the named gate(s) are skipped; every other gate still runs below."
fi

# R-149 (2026-08-11): tells check-pytest.mjs it is running from THIS hook, not from CI's
# `discipline` job (.github/workflows/infra.yml) — only here is `git diff --cached` a meaningful
# question ("what is staged for commit"), and only here should a prose-only change be allowed to
# skip the suite. CI stays unconditional; see check-pytest.mjs's own header for why.
export MATCONETESH_LOCAL_HOOK=1

echo "[pre-commit] running node scripts/check-meta.mjs ..."
node scripts/check-meta.mjs
status=$?
if [ $status -ne 0 ]; then
    echo ""
    echo "[pre-commit] BLOCKED: check-meta.mjs failed (see the specific gate(s) marked FAIL above)."
    echo "[pre-commit] Each gate above names which rule broke, which file, and what to run to fix it."
    echo "[pre-commit] Pre-existing debt is printed as STANDING DEBT and does NOT block by itself — only a NEW or WORSENED finding blocks. If this is still red, the commit in front of you introduces or worsens something."
    echo "[pre-commit] Escape hatch (named gate(s) only, logged — never silent, never blanket by default): META_SKIP_GATE=<gate-id>[,<gate-id>...] git commit ...   (or META_SKIP_GATE=ALL for everything)"
    exit 1
fi
exit 0
