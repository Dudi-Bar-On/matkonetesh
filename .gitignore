# Generated build artifacts — run `python build.py` to regenerate from data.py + sources.py
index.html
dist/
_app_check.js

# Node / Playwright
node_modules/
test-results/
playwright-report/
/playwright/.cache/

# Python
__pycache__/
*.pyc

# Scratch temp files (research provenance in scratch/research/ IS tracked)
scratch/*.png
scratch/*.py
scratch/*.js
scratch/*.output

# Bundles / archives
*.zip

# Machine-local Claude Code settings
.claude/settings.local.json

# agent-memory: a build artifact rebuilt from the .md files by scripts/memsync.py in seconds.
# Never committed — a 22MB binary in git was one of the things that made the old graph unmaintainable.
agent-memory.db
agent-memory.db-wal
agent-memory.db-shm


# Serena (LSP MCP server). project.yml is meant to be versioned; the rest is
# machine-local (symbol caches, language-server logs, per-machine overrides).
.serena/cache/
.serena/logs/
.serena/*.local.yml

# CPU-max program measurement data (scripts/w0-*.mjs, m-cpu-sampler.ps1, m2-*.ps1) — raw per-run
# numbers, regenerated every invocation, not reviewed/diffed like prose. Only the RUNBOOK (and any
# hand-written follow-up analysis doc) is tracked. See docs/research/measurements/RUNBOOK.md.
docs/research/measurements/*.json
docs/research/measurements/*.csv
docs/research/measurements/evidence/
docs/research/measurements/sweep-logs/
.claude-focus

# Infrastructure secrets — never committed. infra/.env.example carries the variable NAMES.
infra/.env
infra/rules-db/.env

# Verified SQLite backups taken before a migration. Kept locally, never committed —
# the database is 30MB+ and a backup is a point-in-time artefact, not source.
backups/

# Test telemetry. Local measurement, not source — and it grows with every run.
test-intel.db
.smoke.tmp

# The extraction run log. Local telemetry of a 12-hour job, regenerated every run.
extraction-run.log

# Runtime coverage observations. Regenerated by every suite run; the map is the artefact.
.coverage-obs/

# Session audit trail (scripts/build-audit.mjs). A near-verbatim projection of a LOCAL Claude Code
# transcript — including everything the owner typed on screen — regenerated on demand. This repo
# is public; publishing that forever into git history buys nothing since it's locally reproducible.
# See docs/audit/README.md for the full reasoning. The README itself IS tracked (negated below).
docs/audit/*.md
!docs/audit/README.md

# Layer-0 runtime output. These are APPEND-ONLY logs and a per-session snapshot: the watchman writes
# one JSON line per component per run (8 lines every 30 minutes), the hook pipeline and the gate
# orchestrator likewise. Tracking them was a slip on 2026-08-07 that put 452 log lines into a commit
# about an index repair, and would have added churn to every commit after it. The evidence they carry
# is local and current-state, never history a clone needs.
.superpowers/*.jsonl
.superpowers/state/

# Enforcement hook runtime state (agent-concurrency ledger, Group B counters, node:sqlite's own
# WAL/SHM side files). Session-scoped, TTL-pruned, regenerated by the next hook invocation — same
# "local and current-state, never history a clone needs" reasoning as the block above. This closes
# a pre-existing gap: agent-ledger.mjs's own ledger.json already lived here untracked but not
# actually covered by any ignore pattern before this line.
.superpowers/hooks-state/
