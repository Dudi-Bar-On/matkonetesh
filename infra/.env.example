# Copy to infra/.env and fill in. infra/.env is gitignored and must never be committed.
# Generate passwords with:  python -c "import secrets;print(secrets.token_urlsafe(32))"

# --- ports (native Windows services: postgresql-x64-18 on 5432, neo4j on 7474/7687) --------
POSTGRES_PORT=5432
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- PostgreSQL ---------------------------------------------------------------------------
POSTGRES_DB=mk_knowledge

# Superuser: used ONLY by the container entrypoint for initialisation. The application must
# never connect as this role.
POSTGRES_SUPERUSER=mk_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_generate_a_random_value

# Least-privilege application role — the single ingestion worker writes as this.
MK_APP_PASSWORD=CHANGE_ME_generate_a_random_value

# Read-only role — every retrieval tool exposed to subagents connects as this.
MK_READER_PASSWORD=CHANGE_ME_generate_a_random_value

# --- Neo4j ---------------------------------------------------------------------------------
# Community edition has no multi-user role management, so there is ONE credential. Read-only
# access is enforced at the tool layer instead; see infra/README.md for the honest limitation.
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_generate_a_random_value
