{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-meta.mjs",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node scripts/session-brief.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node scripts/session-state.mjs",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node scripts/session-rules.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/watchman.ps1",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
